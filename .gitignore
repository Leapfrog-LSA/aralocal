# User workspace data — never commit. .aralegal/ holds the SQLite database
# (including the scrypt password hash and the user's model API keys) and
# files/ holds uploaded documents. Both are created at runtime inside the
# workspace folder the user picks; when that folder is the repo root, they
# appear here.
/.aralegal/
/files/

# Build artifacts — fetched/regenerated locally, never committed.
# vendor/ holds the extracted LibreOffice tree (~1.5 GB) populated by
# scripts/fetch-libreoffice.js. backend/.dist-bundle/ is the staged
# backend (compiled JS + Electron-rebuilt native modules + prod
# node_modules) produced by scripts/stage-backend.js during npm run dist.
/vendor/
backend/.dist-bundle/
